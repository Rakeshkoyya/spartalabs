# Contact form email delivery (Resend). Until both RESEND_API_KEY and
# CONTACT_FROM_EMAIL are set, /api/contact logs the submission and returns a
# 503 telling the sender to email directly — it never reports a message as
# delivered when it was not.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=          # a verified sender on your Resend domain
CONTACT_TO_EMAIL=            # optional, comma-separated for several people; defaults to contact.email in src/content/site.ts

# Canonical origin. Set to https://spartalabs.in in production so canonicals,
# the sitemap and structured data all name the real domain.
NEXT_PUBLIC_SITE_URL=https://spartalabs.in

# Search engine ownership verification. Paste only the content="..." value
# from Google Search Console (HTML tag method) and Bing Webmaster Tools.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
