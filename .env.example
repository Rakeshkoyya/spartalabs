# Contact form email delivery (Resend). Until both RESEND_API_KEY and
# CONTACT_FROM_EMAIL are set, /api/contact logs the submission and returns a
# 503 telling the sender to email directly — it never reports a message as
# delivered when it was not.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=          # a verified sender on your Resend domain
CONTACT_TO_EMAIL=            # optional; defaults to contact.email in src/content/site.ts
